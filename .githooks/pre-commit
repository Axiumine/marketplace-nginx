#!/usr/bin/env bash
# pre-commit — refuse to commit secret files or live secret values.
#
# Installed as a per-repo copy (not a symlink: nothing else can move out from
# under it). Three independent checks — check 0 reads the working tree,
# checks 1-2 the staged index:
#   0. a working-tree env line the parsers here disagree on -> block
#   1. staged PATH looks like a secret file            -> block
#   2. staged ADDED LINES contain a high-entropy secret -> block
#
# Patterns are deliberately narrow, and a line that is a self-declared
# placeholder (`KEY=test-…`) is dropped before the value scan. Override a
# verified false positive with:
#   git commit --no-verify
set -uo pipefail

fail=0

# ---------------------------------------------------------------------------
# Check 0 — an env value broken across two physical lines.
#
# dotenv ends a value at the newline *even inside quotes*, hands back the
# truncated prefix, and then parses the orphan tail — a bare fragment with no
# `KEY=` on it — as its own variable named after its first token. Both halves
# are silent: the service boots, its own suite stays green, and only a peer
# service that must agree on the value ever notices. On 2026-08-09 all five
# `.env` files holding `KEYGRIP_KEY_1`/`_2` were broken this way, 88-char keys
# wrapped after 76, one file carrying the tail twice.
#
# Quoting does not prevent it — every one of those values was correctly quoted
# — so the "quote anything with whitespace" convention (RISK_REGISTER R05) is
# not enough and this runs as a gate instead. R05b.
#
# The second half of the check is R05 itself: a value left UNQUOTED. Measured
# on this platform rather than assumed — `KEY=abc def` is `abc def` to dotenv
# 17.4.2 and an `invalid line` to direnv 2.32.1, which then exports none of the
# shared layer; `KEY=abc#tail` is `abc` to both, silently, because each reads
# the `#` as the start of a comment. One file, two readers, two answers, and
# the truncating one says nothing. A pair of quotes settles every case, so an
# unquoted value holding whitespace or a `#` is blocked here instead of being
# left to a convention that has now been broken twice.
#
# It reads the working tree, not the index, because the file it most needs to
# see is git-ignored and never staged. Line numbers and key names only: no
# value is ever printed, per .claude/SECRETS.md.
#
# A deliberate multi-line value (a PEM body, say) would trip this. None exists
# on this platform; if one is ever added, `git commit --no-verify`.
# ---------------------------------------------------------------------------
env_shape_ok() {
	local f="$1" n=0 line trimmed val q bad=0
	while IFS= read -r line || [ -n "$line" ]; do
		n=$((n + 1))
		trimmed="${line#"${line%%[![:space:]]*}"}"
		case "$trimmed" in '' | '#'*) continue ;; esac
		if [[ ! $trimmed =~ ^[A-Za-z_][A-Za-z_0-9]*= ]]; then
			echo "pre-commit: $f:$n is not a KEY=VALUE line — the value above it is cut in two." >&2
			bad=1
			continue
		fi
		val="${trimmed#*=}"
		# Trailing whitespace only: both readers drop it, so there is nothing to
		# disagree about and flagging it would be a false positive on a stray space.
		val="${val%"${val##*[![:space:]]}"}"
		q="${val:0:1}"
		if [ "$q" = '"' ] || [ "$q" = "'" ]; then
			if [ "${#val}" -lt 2 ] || [ "${val: -1}" != "$q" ]; then
				echo "pre-commit: $f:$n — ${trimmed%%=*} opens a $q quote that never closes on this line." >&2
				bad=1
			fi
		elif [ -n "$val" ]; then
			case "$val" in
			*'#'*)
				echo "pre-commit: $f:$n — ${trimmed%%=*} is unquoted and holds a #, which both readers cut the value at." >&2
				bad=1
				;;
			*[[:space:]]*)
				echo "pre-commit: $f:$n — ${trimmed%%=*} is unquoted and holds whitespace, which direnv refuses outright." >&2
				bad=1
				;;
			esac
		fi
	done < "$f"
	return "$bad"
}

env_shape_fail=0
for envfile in .env .env.* env env.shared; do
	[ -f "$envfile" ] || continue
	env_shape_ok "$envfile" || env_shape_fail=1
done
if [ "$env_shape_fail" -ne 0 ]; then
	echo 'pre-commit: aborted — an env line above is not read the same way by every reader on this platform. A' >&2
	echo '            split value truncates and leaves a junk variable behind (R05b); an unquoted value holding' >&2
	echo '            whitespace or a # is refused by direnv or cut short by dotenv (R05). Rejoin it or quote it;' >&2
	echo '            no value was printed here. Why a gate: docs/workflow.md §Environment files.' >&2
	exit 1
fi

# Credential-bearing filenames, trimmed to what can land in this repo: no npm, yarn,
# direnv, Postgres or GCP tooling here, so `.npmrc`, `.yarnrc`, `.envrc`, `.pgpass`,
# `credentials.json`, `service-account*.json` and `jks` are gone. `key` is added —
# `ssl_certificate_key` names a `.key` file at least as often as a `.pem` one, and this
# is the one repo on the platform where that file would plausibly be created.
SECRET_PATH='(^|/)(\.env(\..*)?|\.netrc|id_rsa|id_dsa|id_ecdsa|id_ed25519)$|\.(pem|key|p12|pfx)$'

# High-entropy formats only. A placeholder (all-x, ${VAR}, empty) must never
# match, or the guard gets disabled by the first false positive.
#
# Narrower than the other five variants of this hook. This repo tracks nginx
# configuration and a shell test harness — no package.json, no env file, no
# JavaScript — so their npm, `.npmrc`, `KEYGRIP_KEY_*` and service-env-key
# branches can never fire here. Only formats that can plausibly land in a conf,
# a snippet or the README are scanned. A `.pem` / `.p12` arriving as a *file* is
# caught by SECRET_PATH above; this catches a key pasted inline instead.
SECRET_VALUE='-----BEGIN [A-Z ]*PRIVATE KEY-----'
SECRET_VALUE+='|mongodb(\+srv)?://[^:/[:space:]]+:[^@[:space:]]{10,}@'
# credential URL: `https://<userinfo>@host` — the shape of a Sentry/Bugsink DSN and of a
# tokenised registry URL. What separates a real one from a placeholder is the userinfo: the
# placeholder is 14 `x`, a real key is 32+ hex. Hence first-char-not-x plus a 20-char floor.
SECRET_VALUE+='|https://[^$x:@/[:space:]"][^:@/[:space:]"]{19,}@'

# Declared-placeholder lines, dropped before the value scan: a whole line whose *only*
# content is `KEY=test-…` / `KEY: 'test-…'` (a self-declared placeholder in a conf or a doc).
# Anchored at both ends on purpose — it can never whitelist a secret that merely appears
# somewhere inside a URI, an object literal or a longer expression, only a line that is
# itself a self-declared placeholder assignment.
PLACEHOLDER='^[[:space:]]*[A-Za-z_][A-Za-z_0-9]*[[:space:]]*[:=][[:space:]]*'
PLACEHOLDER+='["'"'"']?(test|dummy|fake|sample|example|placeholder|changeme|your[-_])[A-Za-z_0-9:/.-]*["'"'"']?,?[[:space:]]*$'

# git's status is taken on its own line, never folded into a pipeline that could hide it. A
# failed `git diff` yields an empty list, and an empty list is exactly what "nothing staged"
# looks like: the two loops would then scan nothing and the commit would pass by having read
# no files at all.
#
# The other five variants filter this list through a SKIP_PATH allowlist for vendored
# secret-scanner rulesets (semgrep, gitleaks, trufflehog), which legitimately carry example
# secret patterns. None of those exist here, so the list is scanned whole.
if ! all_staged="$(git diff --cached --name-only --diff-filter=ACMR)"; then
	echo 'pre-commit: `git diff --cached` failed — refusing to commit rather than scan nothing.' >&2
	exit 1
fi
staged="$all_staged"

while IFS= read -r f; do
	[ -n "$f" ] || continue
	if printf '%s\n' "$f" | grep -Eq -e "$SECRET_PATH"; then
		echo "pre-commit: refusing to commit secret file: $f" >&2
		fail=1
	fi
done <<< "$staged"

while IFS= read -r f; do
	[ -n "$f" ] || continue
	# Added lines only, with the diff's leading '+' stripped so ^-anchors work.
	#
	# `-e` is load-bearing on both greps, not style: SECRET_VALUE starts with the
	# `-----BEGIN` branch, so without it grep reads the pattern as a bundle of options,
	# prints a usage error and exits 2 — and `if` takes the false path, so every staged
	# file passes the scan. A dead guard that still looks installed.
	if git diff --cached -U0 --diff-filter=ACMR -- "$f" | sed -n 's/^+//p' | grep -Eiv -e "$PLACEHOLDER" | grep -Eq -e "$SECRET_VALUE"; then
		echo "pre-commit: $f adds what looks like a live secret value." >&2
		fail=1
	fi
done <<< "$staged"

if [ "$fail" -ne 0 ]; then
	echo 'pre-commit: aborted. Secrets belong in .env (git-ignored); commit only the `env` placeholder template.' >&2
	echo 'pre-commit: if this is genuinely a placeholder, re-run with: git commit --no-verify' >&2
	exit 1
fi

# ---------------------------------------------------------------------------
# Nothing follows, and that is the whole tail.
#
# The other five variants of this hook continue here with the gates their repo
# can actually run — lint, type check, coverage, Qodana. marketplace-nginx
# carries no package.json and no JavaScript, so there is nothing for any of them
# to run against. What this repo does have is test/run.sh, and that needs a
# container engine and an image: minutes of setup on a cold machine, for a repo
# whose ordinary commit is one directive. It runs in .githooks/pre-push instead,
# which is also where a merge commit and anything committed with --no-verify are
# finally seen.
#
# So this file exists for exactly one reason: without it, marketplace-nginx was
# the only repo of the sixteen where a staged credential was caught by nothing.
# ---------------------------------------------------------------------------
exit 0
